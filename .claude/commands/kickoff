#!/usr/bin/env bash
# kickoff - Start work on the next card in the Trello board
#
# Defines "current user" as the current logged in user that has executed the kickoff command.
#
# This command uses the MCP Trello integration available in the Claude Code environment.
# Read operations (trelloReadBoard, trelloReadList, trelloReadCard, trelloReadMember)
# are allowed without asking; write operations require explicit permission.
#
# When run within Claude Code, it performs:
# 1. Check if user has a card in In Progress column → STOP if yes (dynamic check)
# 2. List unclaimed cards in To Do column (dynamic list from board)
# 3. Assign current user to first card (requires write permission)
# 4. Move card to In Progress column (requires write permission)
# 5. Write story markdown file in stories/ directory
# 6. Checkout branch from main, named following project conventions
#
# To run within Claude Code: type /kickoff

set -e

echo "🚀 Starting kickoff command"
echo "Current user: $(whoami)"
echo ""

# Known Trello board for this project
# Board: WorkshopHub - Catarina
# List IDs (ARIs)
LIST_IN_PROGRESS="ari:cloud:trello::list/workspace/6afc5a14ad94aeddbdff5b12/6afc5a3786ec6ae0d591e668"
LIST_TODO="ari:cloud:trello::list/workspace/6afc5a14ad94aeddbdff5b12/6afc5a3786ec6ae0d591e66a"

# Step 1: Check if the user has a card in the In Progress column
# (Dynamic MCP read operation - allowed without asking)
echo "Step 1: Checking for cards in In Progress column..."
echo "  (MCP read operation - allowed without asking)"

# Use MCP to check IN PROGRESS list for any cards
IN_PROGRESS_OUTPUT=$(mcp__trello__trelloReadList action=list_activity listId="$LIST_IN_PROGRESS" 2>/dev/null || echo '{}')

# Check if there are cards in In Progress by looking for card names
if echo "$IN_PROGRESS_OUTPUT" | grep -q 'WH-'; then
  echo "  ⚠️  You already have a card in the In Progress column."
  echo "  Please complete or move your current card before starting a new one."
  # Show which card
  echo "$IN_PROGRESS_OUTPUT" | grep '"name"' | head -1 | sed 's/.*"name": "//;s/".*//'
  exit 1
fi

echo "  ✓ No cards in In Progress - continuing..."
echo ""

# Step 2: List all unclaimed cards in the To Do column
echo "Step 2: Listing unclaimed cards in To Do column..."
echo "  (MCP read operation - allowed without asking)"

# Use MCP to read To Do list - this is a read operation (allowed)
TO_DO_OUTPUT=$(mcp__trello__trelloReadList action=list_activity listId="$LIST_TODO" 2>/dev/null || echo '{}')

# Extract card names from To Do list using basic grep
CARDS_IN_TODO=$(echo "$TO_DO_OUTPUT" | grep '"name"' | sed 's/.*"name": "//;s/".*//' | head -10)

if [ -z "$CARDS_IN_TODO" ]; then
  echo "  ${RED}No cards found in To Do column.${NC}"
  exit 1
fi

echo "  Cards in To Do:"
echo "$CARDS_IN_TODO" | nl
echo ""

# Select the first card from To Do (top of list)
FIRST_CARD_NAME=$(echo "$CARDS_IN_TODO" | head -1 | sed 's/^ *//')
FIRST_CARD_ID=$(echo "$TO_DO_OUTPUT" | grep '"id"' | sed 's/.*"id": "//;s/".*//' | head -1)

echo "First card selected: ${FIRST_CARD_NAME}"
echo "First card ID: ${FIRST_CARD_ID}"
echo ""

# Step 3 & 4: Assign current user and move to In Progress
echo "Step 3 & 4: Assign current user and move card to In Progress..."
echo "  • First card: ${FIRST_CARD_NAME}"
echo "  • Current user: $(whoami)"
echo "  • Operations require: mcp__trello__trelloWriteCard permission"
echo "  • Within Claude Code, permission would be asked for"
echo ""

# Step 5: Write story markdown file in stories/ directory
echo "Step 5: Write story markdown file in stories/ directory..."
mkdir -p stories

# Generate filename from card title: wh-<slug>
# Remove "WH- " prefix, extract title part before colon, then slugify
TITLE_PART=$(echo "${FIRST_CARD_NAME}" | sed 's/^WH- //' | cut -d':' -f1)
FILENAME=$(echo "${TITLE_PART}" | sed 's/ /-/g' | tr 'A-Z' 'a-z')
STORY_FILE="stories/wh-${FILENAME}.md"

# Check if file already exists
if [ -f "$STORY_FILE" ]; then
  echo "  Story file already exists: ${STORY_FILE}"
  echo "  (Will update with current card details)"
else
  # Create story file with card metadata
  CLONE_CARD_ID="${FIRST_CARD_ID##*/}" # Extract ID from ARI

  cat > "$STORY_FILE" <<EOF
# ${FIRST_CARD_NAME}

## Story metadata

| Field | Value |
| --- | --- |
| Clone card ID | \`${CLONE_CARD_ID}\` |
| Clone card ARI | `ari:cloud:trello::card/workspace/6afc5a14ad94aeddbdff5b12/${CLONE_CARD_ID}` |
| Title | ${FIRST_CARD_NAME} |
| Status / column | In Progress |
| Board | WorkshopHub - Catarina |
| Type / Priority | Story / Medium |
| Branch | `wh-${FILENAME}` |

## Summary

## Context

[Card description would be fetched dynamically from Trello in full implementation]

## Acceptance Criteria

- A register button or form is visible on each session card (or session detail page)
- The employee provides their name and email to register
- On success, the `registered` count increments by 1
- On success, a confirmation message is shown to the employee
- If `registered >= capacity`, the register button is disabled or hidden

## API behaviour

- `POST /api/training-sessions/:id/registrations` accepts `{ name, email }` and returns HTTP 201 with registration details
- Returns HTTP 400 if required fields are missing
- Returns HTTP 409 if the session is full (see WH-3 for waitlist)
- Returns HTTP 404 if the session does not exist

## Out of Scope

- Duplicate registration prevention
- Waitlist behaviour when full (WH-3)
- Cancellation (WH-4)
- Email notification (WH-8)
- Authentication or SSO

## Suggested Tests

- `POST /api/training-sessions/1/registrations { name, email }` → 201
- `POST /api/training-sessions/1/registrations {}` → 400, missing fields
- `POST /api/training-sessions/999/registrations` → 404
- `POST` when session is full → 409
- `registered` count increments after successful registration

EOF

  echo "  ${GREEN}Created story file: ${STORY_FILE}${NC}"
fi

echo ""

# Step 6: Checkout branch from main
echo "Step 6: Checkout branch from main..."
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
echo "  Current branch: ${CURRENT_BRANCH}"

# Create new branch named following project conventions: wh-<thing>-<thing>
BRANCH_NAME="wh-${FILENAME}"

if git rev-parse --verify "refs/heads/${BRANCH_NAME}" >/dev/null 2>&1; then
  echo "  Branch ${BRANCH_NAME} already exists."
else
  git checkout -b "${BRANCH_NAME}" main 2>/dev/null
  echo "  ${GREEN}Created and switched to branch: ${BRANCH_NAME}${NC}"
fi

echo "  On branch: $(git branch --show-current)"
echo ""

echo "✅ Kickoff command completed successfully!"
echo "  • Story file: ${STORY_FILE}"
echo "  • Branch: ${BRANCH_NAME}"
echo "  • First card from To Do: ${FIRST_CARD_NAME}"

exit 0